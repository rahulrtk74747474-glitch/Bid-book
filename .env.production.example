# Copy to .env.production on the production host. Never commit the real file.
BIDBOOK_DOMAIN=api.example.com
PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://admin.example.com

POSTGRES_DB=bidbook
POSTGRES_USER=bidbook
POSTGRES_PASSWORD=generate-a-strong-unique-database-password
JWT_SECRET=generate-at-least-48-random-characters
OTP_PEPPER=generate-at-least-32-random-characters
ADMIN_PHONES=+91XXXXXXXXXX
ADMIN_MFA_SECRET=BASE32_AUTHENTICATOR_SECRET
PLATFORM_FEE_BPS=0

SMS_PROVIDER=http
SMS_HTTP_URL=https://your-sms-provider.example/send
SMS_HTTP_TOKEN=
SMS_SENDER_ID=BIDBOOK

PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PAYOUT_HTTP_URL=https://your-settlement-provider.example/payouts
PAYOUT_HTTP_TOKEN=
PAYOUT_WEBHOOK_SECRET=

IDENTITY_HTTP_URL=https://your-approved-identity-provider.example/verifications
IDENTITY_HTTP_TOKEN=
IDENTITY_WEBHOOK_SECRET=

STORAGE_PROVIDER=s3
STORAGE_PUBLIC_BASE_URL=https://media.example.com
S3_BUCKET=bidbook-production
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_SECONDS=900

FIREBASE_CREDENTIALS_HOST_PATH=./secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json
PUSH_BATCH_SIZE=100
PUSH_POLL_SECONDS=2

GLOBAL_RATE_LIMIT_PER_MINUTE=180
AUTH_RATE_LIMIT_PER_MINUTE=30
REQUEST_BODY_MAX_BYTES=10485760
TRUST_PROXY_HEADERS=true
EXPOSE_DEVELOPMENT_OTP=false
AUTO_CREATE_TABLES=false
