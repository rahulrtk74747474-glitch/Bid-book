# Core
ENVIRONMENT=development
PUBLIC_API_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql+asyncpg://bidbook:bidbook@localhost:5432/bidbook
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-48-random-characters-before-production
OTP_PEPPER=replace-with-at-least-32-random-characters-before-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AUTO_CREATE_TABLES=true

# Authentication / abuse controls
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=45
OTP_HOURLY_LIMIT=8
EXPOSE_DEVELOPMENT_OTP=true
GLOBAL_RATE_LIMIT_PER_MINUTE=180
AUTH_RATE_LIMIT_PER_MINUTE=30
REQUEST_BODY_MAX_BYTES=10485760
TRUST_PROXY_HEADERS=false
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Admins: never expose these values to the mobile client.
ADMIN_PHONES=
ADMIN_MFA_SECRET=
ADMIN_STEPUP_MINUTES=10

# Object storage
STORAGE_PROVIDER=development
STORAGE_PUBLIC_BASE_URL=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_SECONDS=900

# SMS / OTP delivery
SMS_PROVIDER=development
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=BIDBOOK
SMS_TEMPLATE=Your Bid&Book OTP is {otp}. It expires in 5 minutes.

# Payments
PAYMENT_PROVIDER=development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_FEE_BPS=0

# Provider settlements / payouts
PAYOUT_HTTP_URL=
PAYOUT_HTTP_TOKEN=
PAYOUT_WEBHOOK_SECRET=

# Identity verification provider
IDENTITY_HTTP_URL=
IDENTITY_HTTP_TOKEN=
IDENTITY_WEBHOOK_SECRET=

# Push notifications
FIREBASE_CREDENTIALS_FILE=
PUSH_BATCH_SIZE=100
PUSH_POLL_SECONDS=2
